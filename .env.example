NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Needed for BankID account provisioning (server-only, never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BankID login via Idura Verify (https://docs.idura.app/verify/e-ids/swedish-bankid/).
# The older CRIIPTO_DOMAIN / CRIIPTO_CLIENT_ID / CRIIPTO_CLIENT_SECRET names also work.
# Production: https://xn--hyresvgen-02a.se (hyresvägen.se in punycode)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on /kontakt. Defaults to hej@hyresvägen.se.
NEXT_PUBLIC_CONTACT_EMAIL=
IDURA_DOMAIN=your-tenant.idura.broker
IDURA_CLIENT_ID=your-client-id
IDURA_CLIENT_SECRET=your-client-secret

# Outgoing email (household invites, new-message notifications). Optional —
# can instead be set at /admin/installningar. When SMTP_HOST/USER/PASS are
# set here they take precedence and the admin form becomes read-only.
# Gmail: host smtp.gmail.com, port 465 + SMTP_SECURE=true (or 587 + false for
# STARTTLS), user = the full Gmail address, pass = a 16-character App Password
# from https://myaccount.google.com/apppasswords (needs 2-step verification;
# your normal Google password will not work). FROM_EMAIL must be the Gmail
# address or a verified "Send mail as" alias.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Hyresvägen
SMTP_FROM_EMAIL=
