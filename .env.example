NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Needed for BankID account provisioning (server-only, never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BankID login via Idura Verify (https://docs.idura.app/verify/e-ids/swedish-bankid/).
# The older CRIIPTO_DOMAIN / CRIIPTO_CLIENT_ID / CRIIPTO_CLIENT_SECRET names also work.
NEXT_PUBLIC_APP_URL=http://localhost:3000
IDURA_DOMAIN=your-tenant.idura.broker
IDURA_CLIENT_ID=your-client-id
IDURA_CLIENT_SECRET=your-client-secret
